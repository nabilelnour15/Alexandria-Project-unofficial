# Copy to .env.local (gitignored) and fill in. Used only by local scripts, never by the site.
# Do NOT prefix these with VITE_, or Vite will bundle them into the public JavaScript.

# Google AI Studio key for `npm run gen:image` (scripts/gen-image.mjs)
GEMINI_API_KEY=
# Optional: override the image model (default gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=
